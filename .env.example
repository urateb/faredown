# https://serpapi.com/users/sign_up — 250 free Google Flights searches/month.
# Server-side only. Do not prefix with NEXT_PUBLIC_.
SERPAPI_KEY=

# ISO 4217. One of EUR, USD, GBP, CAD, AUD, CHF.
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR

# Used for canonical URLs, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
